{
  "multipart": [
    {"apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_core"}},
    {"when": {"north": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side"}},
    {"when": {"east": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side", "y": 90}},
    {"when": {"south": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side", "y": 180}},
    {"when": {"west": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side", "y": 270}},
    {"when": {"up": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side", "x": 270}},
    {"when": {"down": "true"}, "apply": {"model": "mekanism_more_multiblock:block/quantum_item_pipe_side", "x": 90}}
  ]
}
